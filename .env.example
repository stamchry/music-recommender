LISTENBRAINZ_USERNAME=your_username_here
# Optional API Token for higher rate limits
LISTENBRAINZ_TOKEN=your_token_here

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# Set this to enable S3 upload/download
AWS_S3_BUCKET=your_s3_bucket_name

# Prevent OpenBLAS thread oversubscription in implicit ALS
OPENBLAS_NUM_THREADS=1
